---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const pages = await getCollection("docs");
  return pages.filter((p) => p.id !== "_index").map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content, headings } = await render(page);

// "On this page": h2 entries with their h3 children, like the old Hugo TOC.
type TocItem = { slug: string; text: string; children: TocItem[] };
const toc: TocItem[] = [];
for (const h of headings) {
  if (h.depth === 2) toc.push({ slug: h.slug, text: h.text, children: [] });
  else if (h.depth === 3 && toc.length) toc[toc.length - 1].children.push({ slug: h.slug, text: h.text, children: [] });
}
---

<Base title={page.data.title} description={page.data.description}>
  <article class="doc">
    <header class="doc-header">
      <p class="crumb"><a href="/docs/">Docs</a></p>
      <h1>{page.data.title}</h1>
    </header>
    {
      toc.length > 0 && (
        <aside class="toc" aria-label="On this page">
          <p class="toc-title">On this page</p>
          <nav>
            <ul>
              {toc.map((item) => (
                <li>
                  <a href={`#${item.slug}`}>{item.text}</a>
                  {item.children.length > 0 && (
                    <ul>
                      {item.children.map((c) => (
                        <li>
                          <a href={`#${c.slug}`}>{c.text}</a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
    <div class="content">
      <Content />
    </div>
  </article>
</Base>
