<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Quick Look / thumbnail appex. Sandbox is required. The host app is not
	     sandboxed. Both share the macOS-style App Group (team id prefix, not
	     the iOS "group." form) so no provisioning profile is required.
	     The home-relative exception is the fallback when containerURL is nil
	     (unsigned uv run, ad-hoc bundle). It names one JSON file. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>83546T4BT8.com.vfxtools.exrconverter</string>
	</array>
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/Library/Application Support/EXR Converter/quicklook.json</string>
	</array>
</dict>
</plist>
