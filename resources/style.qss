/* ==========================================================================
   EXR Converter — neutral dark theme, one orange accent
   Loaded as Qt resource  :/style.qss

   Colours are tokens:  @VARNAME  is substituted at load time from PALETTE in
   src/gui/style.py. Do not write hex values here; add a token instead.

   Rules of the theme
   - Greys carry no tint: colour work happens next to this window.
   - Orange means primary action, selection, or keyboard focus. Hover is a
     lighter grey edge, never orange.
   - Single-line controls are 32 px tall: 22 px content + 4 px padding + 1 px
     border, top and bottom. Tests pin that height.
   - Variants are dynamic properties set with style.set_style_property, e.g.
     QLabel[role="hint"], QToolButton[state="invalid"].
   ========================================================================== */

/* ---- Base ---- */
QWidget {
    background-color: @BG;
    color: @FG;
    font-size: 13px;
    selection-background-color: @SEL_BG;
    selection-color: @SEL_FG;
}
QLabel {
    background-color: transparent;
}
QToolTip {
    background-color: @BG_ALT;
    color: @FG;
    border: 1px solid @BORDER_STRONG;
    padding: 4px 6px;
}

/* ---- Text roles ---- */
QLabel[role="muted"] {
    color: @FG_DIM;
}
QLabel[role="hint"] {
    color: @FG_DIM;
    font-size: 11px;
}
QLabel[role="caption"] {
    color: @FG_DIM;
    font-size: 10px;
}
QLabel[role="section"] {
    color: @FG_DIM;
    font-size: 11px;
    font-weight: 600;
}
QLabel[state="ok"] {
    color: @SUCCESS;
}
QLabel[state="error"] {
    color: @ERROR;
}
QLabel[state="warning"] {
    color: @WARNING;
}
QLabel#dimLabel {
    color: @FG_DIM;
    font-size: 11px;
}

/* ---- Sections (QGroupBox) ----
   A section is a dim title over a hairline, not a box: fewer nested frames,
   and the controls line up with the window edge. */
QGroupBox {
    border: none;
    border-top: 1px solid @BORDER;
    border-radius: 0;
    margin-top: 20px;
    padding: 4px 0 0 0;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 0;
    top: 2px;
    padding: 0;
    color: @FG_DIM;
    font-size: 11px;
}
QGroupBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid @BORDER_STRONG;
    border-radius: 3px;
    background-color: @BG_INPUT;
}
QGroupBox::indicator:checked {
    background-color: @ACCENT;
    border-color: @ACCENT_DARK;
    image: url(:/check.png);
}
QGroupBox#ocioPanel {
    border-top: none;
    margin-top: 0;
    padding: 0;
}

/* ---- Inputs ---- */
QLineEdit, QSpinBox, QDoubleSpinBox, QPlainTextEdit, QTextEdit {
    background-color: @BG_INPUT;
    border: 1px solid @BORDER;
    border-radius: 4px;
    padding: 4px 8px;
    color: @FG;
}
QLineEdit, QSpinBox, QDoubleSpinBox {
    /* Content-box floor; Python lock_form_row_height is the widget floor. */
    min-height: 22px;
}
QSpinBox, QDoubleSpinBox {
    /* Room for up/down arrows without eating the value digits. */
    padding-right: 20px;
    min-width: 56px;
}
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: @BORDER_STRONG;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QPlainTextEdit:focus, QTextEdit:focus {
    border-color: @ACCENT;
}
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    color: @FG_DISABLED;
    background-color: @BG;
    border-color: @BORDER;
}

/* ---- SpinBox buttons ---- */
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    border: none;
    border-left: 1px solid @BORDER;
    border-top-right-radius: 3px;
    background-color: transparent;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 18px;
    border: none;
    border-left: 1px solid @BORDER;
    border-bottom-right-radius: 3px;
    background-color: transparent;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: @BG_BTN_HOVER;
}
QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background-color: @BG_BTN_PRESSED;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(:/arrow_up.png);
    width: 10px;
    height: 10px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(:/arrow_down.png);
    width: 10px;
    height: 10px;
}

/* ---- ComboBox ---- */
QComboBox {
    background-color: @BG_INPUT;
    border: 1px solid @BORDER;
    border-radius: 4px;
    padding: 4px 8px;
    color: @FG;
    min-height: 22px;
}
QComboBox:hover {
    border-color: @BORDER_STRONG;
}
QComboBox:focus, QComboBox:on {
    border-color: @ACCENT;
}
QComboBox:disabled {
    color: @FG_DISABLED;
    background-color: @BG;
}
QComboBox::drop-down {
    border: none;
    width: 26px;
}
QComboBox::down-arrow {
    image: url(:/arrow_down.png);
    width: 12px;
    height: 12px;
}
QComboBox::down-arrow:on {
    image: url(:/arrow_down_accent.png);
}
QComboBox QAbstractItemView {
    background-color: @BG_ALT;
    border: 1px solid @BORDER_STRONG;
    selection-background-color: @SEL_BG;
    selection-color: @SEL_FG;
    outline: 0;
    padding: 2px;
}

/* ---- Buttons ---- */
QPushButton {
    background-color: @BG_BTN;
    border: 1px solid @BORDER;
    border-radius: 4px;
    /* 4px vertical matches QLineEdit so Browse sits flush with the path field. */
    padding: 4px 14px;
    color: @FG;
    min-height: 22px;
}
QPushButton:hover {
    background-color: @BG_BTN_HOVER;
    border-color: @BORDER_STRONG;
}
QPushButton:pressed {
    background-color: @BG_BTN_PRESSED;
}
QPushButton:focus {
    border-color: @ACCENT;
}
QPushButton:checked {
    background-color: @SEL_BG;
    border-color: @ACCENT_DARK;
    color: @SEL_FG;
}
QPushButton:disabled {
    color: @FG_DISABLED;
    background-color: @BG;
    border-color: @BORDER;
}

/* Primary action — same box as Cancel, so the row stays one height. */
QPushButton#convertBtn, QPushButton[variant="primary"] {
    background-color: @ACCENT;
    color: @ACCENT_FG;
    font-weight: 600;
    border: 1px solid @ACCENT_DARK;
    padding: 4px 26px;
    min-height: 22px;
}
QPushButton#convertBtn:hover, QPushButton[variant="primary"]:hover {
    background-color: @ACCENT_HOVER;
    border-color: @ACCENT;
}
QPushButton#convertBtn:pressed, QPushButton[variant="primary"]:pressed {
    background-color: @ACCENT_DARK;
}
QPushButton#convertBtn:focus, QPushButton[variant="primary"]:focus {
    border-color: @SEL_FG;
}
QPushButton#convertBtn:disabled, QPushButton[variant="primary"]:disabled {
    background-color: @BG_BTN;
    color: @FG_DISABLED;
    border-color: @BORDER;
}

/* Quiet buttons: an icon or a short word that should not compete. */
QPushButton[variant="ghost"], QToolButton[variant="ghost"] {
    background-color: transparent;
    border: 1px solid transparent;
    padding: 4px 6px;
    color: @FG_DIM;
}
QPushButton[variant="ghost"]:hover, QToolButton[variant="ghost"]:hover {
    background-color: @BG_BTN;
    border-color: @BORDER;
    color: @FG;
}
QPushButton[variant="ghost"]:pressed, QToolButton[variant="ghost"]:pressed {
    background-color: @BG_BTN_PRESSED;
}
QPushButton[variant="ghost"]:checked, QToolButton[variant="ghost"]:checked {
    background-color: @BG_BTN;
    border-color: @BORDER;
    color: @FG;
}
QPushButton[variant="ghost"]:disabled, QToolButton[variant="ghost"]:disabled {
    color: @FG_DISABLED;
    background-color: transparent;
    border-color: transparent;
}
QPushButton#gearBtn {
    padding: 2px 4px;
    min-width: 24px;
    max-width: 28px;
}
QPushButton#clearBtn {
    padding: 2px 10px;
    font-size: 11px;
    min-height: 18px;
}

/* ---- ToolButton ----
   Plain tool buttons are small quiet buttons. PickerButton (color space,
   codec) opens a menu, so it looks like a combo: field fill and a chevron. */
QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 3px 5px;
    font-size: 13px;
    color: @FG;
}
PickerButton {
    background-color: @BG_INPUT;
    background-image: url(:/arrow_down.png);
    background-repeat: no-repeat;
    background-position: right center;
    background-origin: content;
    border: 1px solid @BORDER;
    padding: 4px 8px;
    min-height: 22px;
}
QToolButton:hover:!disabled {
    background-color: @BG_BTN;
}
PickerButton:hover:!disabled {
    background-color: @BG_INPUT;
}
QToolButton:hover {
    border-color: @BORDER_STRONG;
}
QToolButton:focus, QToolButton:pressed {
    border-color: @ACCENT;
}
QToolButton:disabled {
    color: @FG_DISABLED;
}
PickerButton:disabled {
    background-color: @BG;
}
QToolButton::menu-indicator {
    image: none;
}
PickerButton[state="invalid"] {
    color: @ERROR;
    border-color: @ERROR_BORDER;
    background-color: @ERROR_BG;
}
PickerButton[state="auto"] {
    color: @WARNING;
    border-color: @WARNING_BORDER;
    background-color: @WARNING_BG;
}
/* Compact strip buttons: transport, in / out. */
QToolButton[variant="tool"], QPushButton[variant="tool"] {
    background-color: @BG_BTN;
    border: 1px solid @BORDER;
    border-radius: 3px;
    padding: 0 6px;
    font-size: 11px;
    min-height: 0;
}
QPushButton[variant="tool"] {
    padding: 0;
}
QToolButton[variant="tool"]:hover, QPushButton[variant="tool"]:hover {
    background-color: @BG_BTN_HOVER;
    border-color: @BORDER_STRONG;
}
QToolButton[variant="tool"]:pressed, QPushButton[variant="tool"]:pressed {
    background-color: @BG_BTN_PRESSED;
}
QToolButton[variant="tool"]:checked, QPushButton[variant="tool"]:checked {
    background-color: @SEL_BG;
    border-color: @ACCENT_DARK;
    color: @SEL_FG;
}
QToolButton[variant="tool"]:disabled, QPushButton[variant="tool"]:disabled {
    color: @FG_DISABLED;
    background-color: @BG;
}

/* Transient highlight on a field the app just filled in. */
QWidget[flash="true"] {
    background-color: @WARNING_BG;
}

/* ---- SegmentedControl (List | Grid, etc.) ----
   Pill track + exclusive segments. Requires WA_StyledBackground on the host.
*/
QWidget#SegmentedControl {
    background-color: @BG_INPUT;
    border: 1px solid @BORDER;
    border-radius: 7px;
    padding: 0;
}
QWidget#SegmentedControl > QPushButton {
    background-color: transparent;
    border: none;
    border-radius: 5px;
    padding: 3px 12px;
    margin: 0;
    min-height: 20px;
    min-width: 44px;
    color: @FG_DIM;
    font-size: 12px;
    font-weight: normal;
}
QWidget#SegmentedControl > QPushButton:hover:!checked {
    color: @FG;
    background-color: @BG_ALT;
}
QWidget#SegmentedControl > QPushButton:checked {
    background-color: @BG_BTN;
    color: @SEL_FG;
    font-weight: 500;
    /* subtle inner edge so the selected pill reads as a raised segment */
    border: 1px solid @BORDER_STRONG;
}
QWidget#SegmentedControl > QPushButton:checked:hover {
    background-color: @BG_BTN_HOVER;
    color: @SEL_FG;
}
QWidget#SegmentedControl > QPushButton:pressed {
    background-color: @BG_BTN_PRESSED;
}
QWidget#SegmentedControl > QPushButton:disabled {
    color: @FG_DISABLED;
}
/* Focus ring only when keyboard-focused (tab), not on mouse click.
   Property is set by SegmentedControl.focusInEvent / focusOutEvent. */
QWidget#SegmentedControl[keyboardFocus="true"] {
    border-color: @ACCENT;
}

/* ---- TabWidget ----
   Underlined tabs: the page sits on the window, no frame around it. */
QTabWidget::pane {
    border: none;
    border-top: 1px solid @BORDER;
    background-color: @BG;
}
QTabBar {
    background-color: transparent;
}
QTabBar::tab {
    background-color: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 7px 14px 6px 14px;
    margin-right: 4px;
    color: @FG_DIM;
}
/* The accent underline is painted by SlidingTabBar so it can travel. */
QTabBar::tab:selected {
    color: @SEL_FG;
    font-weight: 600;
}
QTabBar::tab:hover:!selected {
    color: @FG;
}
QScrollArea#convertTabScroll, QWidget#convertTabBody {
    background-color: @BG;
    border: none;
}

/* ---- Slider ---- */
QSlider::groove:horizontal {
    height: 4px;
    background: @BORDER;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: @FG;
    border: 1px solid @BG;
    width: 12px;
    height: 12px;
    margin: -5px 0;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    background: @SEL_FG;
}
QSlider::sub-page:horizontal {
    background: @ACCENT;
    border-radius: 2px;
}

/* ---- Progress bar ---- */
QProgressBar {
    background-color: @BG_INPUT;
    border: 1px solid @BORDER;
    border-radius: 4px;
    text-align: center;
    color: @FG;
    min-height: 14px;
}
/* #convertProgress is a ProgressLine: it paints itself (3 px, animated). */
QProgressBar#convertProgress {
    min-height: 0;
    border: none;
    background: transparent;
}
QProgressBar::chunk {
    background-color: @ACCENT_DARK;
    border-radius: 3px;
}

/* ---- Scrollbar ---- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    border: none;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: @SCROLLBAR;
    border-radius: 3px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: @SCROLLBAR_HOVER;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    border: none;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: @SCROLLBAR;
    border-radius: 3px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover {
    background: @SCROLLBAR_HOVER;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* ---- Lists, trees, tables ---- */
QTreeView, QTableWidget, QTableView, QListView, QListWidget {
    background-color: @BG_INPUT;
    alternate-background-color: @BG;
    border: 1px solid @BORDER;
    border-radius: 4px;
    gridline-color: transparent;
    outline: 0;
}
QTreeView::item, QTableView::item, QTableWidget::item,
QListView::item, QListWidget::item {
    padding: 3px 4px;
    border: none;
}
QTreeView::item:hover, QTableWidget::item:hover, QTableView::item:hover,
QListView::item:hover, QListWidget::item:hover {
    background-color: @BG_ALT;
}
QTreeView::item:selected, QTableWidget::item:selected, QTableView::item:selected,
QListView::item:selected, QListWidget::item:selected {
    background-color: @SEL_BG;
    color: @SEL_FG;
}
QTreeView::item:selected:hover, QTableWidget::item:selected:hover,
QTableView::item:selected:hover, QListView::item:selected:hover,
QListWidget::item:selected:hover {
    background-color: @SEL_BG_HOVER;
    color: @SEL_FG;
}
QTreeView::branch {
    background-color: transparent;
}
QTreeView::branch:has-children:closed {
    image: url(:/branch_closed.png);
}
QTreeView::branch:has-children:open {
    image: url(:/branch_open.png);
}
QHeaderView {
    background-color: @BG_INPUT;
    border: none;
}
QHeaderView::section {
    background-color: @BG_INPUT;
    border: none;
    border-bottom: 1px solid @BORDER;
    padding: 5px 8px;
    color: @FG_DIM;
    font-weight: 600;
    font-size: 11px;
}
QTableCornerButton::section {
    background-color: @BG_INPUT;
    border: none;
}

/* ---- Splitter ---- */
QSplitter::handle {
    background-color: @BORDER;
}
QSplitter::handle:hover {
    background-color: @BORDER_STRONG;
}
QSplitter::handle:vertical {
    height: 1px;
}
QSplitter::handle:horizontal {
    width: 1px;
}

/* ---- StatusBar ---- */
QStatusBar {
    background-color: @BG;
    border-top: 1px solid @BORDER;
    color: @FG_DIM;
    font-size: 11px;
}
QStatusBar::item {
    border: none;
}

/* ---- Menu ---- */
QMenuBar {
    background-color: @BG;
    border-bottom: 1px solid @BORDER;
    color: @FG;
    padding: 2px 4px;
}
QMenuBar::item {
    background-color: transparent;
    padding: 4px 9px;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background-color: @BG_BTN;
    color: @SEL_FG;
}
QMenu {
    background-color: @BG_ALT;
    border: 1px solid @BORDER_STRONG;
    color: @FG;
    padding: 4px;
}
QMenu::item {
    padding: 5px 24px 5px 12px;
    border-radius: 3px;
}
QMenu::item:selected {
    background-color: @SEL_BG;
    color: @SEL_FG;
}
QMenu::item:disabled {
    color: @FG_DISABLED;
}
QMenu::separator {
    height: 1px;
    background: @BORDER;
    margin: 4px 6px;
}
QMenu::right-arrow {
    image: url(:/arrow_right.png);
    width: 12px;
    height: 12px;
    right: 4px;
}

/* ---- CheckBox / RadioButton ---- */
QCheckBox, QRadioButton {
    spacing: 7px;
    color: @FG;
    background-color: transparent;
}
QCheckBox:disabled, QRadioButton:disabled {
    color: @FG_DISABLED;
}
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid @BORDER_STRONG;
    border-radius: 3px;
    background-color: @BG_INPUT;
}
QCheckBox::indicator:checked {
    background-color: @ACCENT;
    border-color: @ACCENT_DARK;
    image: url(:/check.png);
}
QCheckBox::indicator:disabled {
    background-color: @BG_ALT;
    border-color: @BORDER;
}
QCheckBox::indicator:checked:disabled {
    /* Mute accent so nested boxes (e.g. Tile under an unchecked Watermark
       group) do not still look clickable/active. */
    background-color: @BG_BTN;
    border-color: @BORDER;
    image: url(:/check.png);
}
QCheckBox::indicator:hover {
    border-color: @FG_DIM;
}
QCheckBox::indicator:hover:disabled {
    border-color: @BORDER;
}
QCheckBox:focus, QRadioButton:focus {
    color: @SEL_FG;
}
QCheckBox::indicator:focus {
    border-color: @ACCENT;
}
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid @BORDER_STRONG;
    border-radius: 8px;
    background-color: @BG_INPUT;
}
QRadioButton::indicator:checked {
    border: 4px solid @ACCENT;
    background-color: @ACCENT_FG;
    width: 8px;
    height: 8px;
}
QRadioButton::indicator:focus {
    border-color: @ACCENT;
}

/* ---- Dialog buttons ---- */
QDialogButtonBox QPushButton {
    min-width: 70px;
}

/* ---- Log drawer ---- */
QWidget#logDrawer {
    border-top: 1px solid @BORDER;
}
QPushButton#logToggle {
    padding: 2px 8px 2px 4px;
    min-height: 20px;
    font-size: 11px;
    font-weight: 600;
    text-align: left;
}
QPushButton#logToggle:checked {
    background-color: transparent;
    border-color: transparent;
    color: @FG;
}

/* ---- Log pane ---- */
QPlainTextEdit#logPane {
    background: @BG_INPUT;
    color: @FG_DIM;
    border: 1px solid @BORDER;
    font-family: 'Menlo', 'Monaco', 'Consolas', 'Courier New';
    font-size: 11px;
}

/* ---- Metadata inspector pane ---- */
QPlainTextEdit#metaPane {
    font-size: 11px;
    font-family: 'Menlo', 'Monaco', 'Consolas', 'Courier New';
}

/* ---- Browser ---- */
QListWidget#placesList {
    background-color: transparent;
    border: none;
}
QListWidget#placesList::item {
    padding: 4px 6px;
    border-radius: 4px;
}
QTableWidget#browserTable::item, QTableView#browserTable::item {
    padding: 5px 8px;
}

/* ---- Viewer ---- */
QWidget#viewerSurround {
    background-color: @VIEWER_BG;
}
